{
  "ConnectionStrings": {
    "DefaultConnection": "Server=host.docker.internal;Database=NetflixCloneDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Tmdb": {
    "ApiKey": "YOUR_TMDB_API_KEY",
    "BaseUrl": "https://api.themoviedb.org/3"
  },
  "Import": {
    "PagesPerGenre": 3,
    "DiscoverPages": 10,
    "MinimumVoteCount": 100,
    "ImportMovies": true,
    "ImportTvSeries": true
  },
  "Logging": {
    "LogLevel": {
    "Default": "Information",
    "Microsoft.AspNetCore": "Warning",
    "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}